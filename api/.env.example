APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Staging and production must set this explicitly to their replica-set or sharded-cluster URI.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=moneytracking
# Required and explicit in staging and production; localhost values are development-only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL=720h
MAX_BODY_BYTES=1048576
MAX_HEADER_BYTES=1048576
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=35s
IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
# Comma-separated proxy IPs or CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=
