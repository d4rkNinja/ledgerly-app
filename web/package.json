{
  "name": "moneytracking-ledgerly-web",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "check": "npm run test:run && npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "android:doctor": "node ../applications/android/scripts/android.mjs doctor",
    "android:setup": "node ../applications/android/scripts/android.mjs setup",
    "android:setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../applications/android/scripts/create-android-app.ps1",
    "android:sync": "node ../applications/android/scripts/android.mjs sync",
    "android:assets": "node ../applications/android/scripts/android.mjs assets",
    "android:open": "node ../applications/android/scripts/android.mjs open",
    "android:run": "node ../applications/android/scripts/android.mjs run",
    "android:build": "npm run android:build:debug",
    "android:build:debug": "node ../applications/android/scripts/android.mjs build debug",
    "android:build:release": "node ../applications/android/scripts/android.mjs build release",
    "android:test": "node ../applications/android/scripts/android.mjs test",
    "android:clean": "node ../applications/android/scripts/android.mjs clean",
    "test:scripts": "node --test ../applications/android/scripts/__tests__/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@paper-design/shaders-react": "^0.0.77",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "clsx": "^2.1.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.0.1",
    "oxlint": "^1.71.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.1.1",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "npm": ">=10"
  }
